<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/tv_app_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="XCLogger Test Demo"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Target:" />

        <Spinner
            android:id="@+id/spinner_pkg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="STATUS: --"
        android:textSize="16sp"
        android:layout_marginTop="8dp"
        android:textColor="#FF888888" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <Button android:id="@+id/btn_start" android:text="START"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" />
        <Button android:id="@+id/btn_stop" android:text="STOP"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <Button android:id="@+id/btn_config" android:text="CONFIG"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" />
        <Button android:id="@+id/btn_compress" android:text="COMPRESS"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" />
        <Button android:id="@+id/btn_autotest" android:text="AUTOTEST"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_stress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="LOG STRESS" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#FFCCCCCC"
        android:layout_marginTop="8dp" />

    <ScrollView
        android:id="@+id/sv_log"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/tv_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:text="Awaiting connection..." />
    </ScrollView>
</LinearLayout>
