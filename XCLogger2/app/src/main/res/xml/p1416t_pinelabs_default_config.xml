<?xml version="1.0" encoding="utf-8"?>
<XcLoggerConfig xmlns:android="http://schemas.android.com/apk/res/android">

<!--  Total size （MB）  -->
    <total_size>300</total_size>

<!--  Log file max size （MB）  -->
    <file_size>4</file_size>

<!--  Buffer size （byte）  -->
    <buffer_size>2048</buffer_size>

<!--  Log directory path  -->
    <log_dir>/storage/emulated/0/XcLogger</log_dir>

<!--  Log coverage period (Hour) - 4 days  -->
    <log_period>96</log_period>

<!--  Initial auto start after default config is imported for the first time  -->
    <auto_start_enabled>true</auto_start_enabled>

<!--  Filtering rules  -->
    <filtering_rules>
        <!-- all-No filtering -->
        <tag>all</tag>
        <!-- all-No filtering, D, V, W, E (levels name separated by ,)-->
        <level>v</level>
        <!-- all-No filtering (packages name separated by ,) -->
        <package_name>all</package_name>
        <package_filter_mode>whitelist</package_filter_mode>

        <!-- Blacklist (optional): elements to exclude from whitelist results -->
        <tag_blacklist></tag_blacklist>
        <package_blacklist></package_blacklist>
        <level_blacklist></level_blacklist>

        <!-- Content filter (optional): keyword-based whitelist/blacklist -->
        <content></content>
        <content_blacklist></content_blacklist>
    </filtering_rules>

</XcLoggerConfig>
